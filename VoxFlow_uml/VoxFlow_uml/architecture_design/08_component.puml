@startuml
title <size:20><b>VoxFlow - Component Architecture Diagram</b></size>\n<size:12>Speech Fluency & Disfluency Session Analyzer</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
    FontStyle bold
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    BorderThickness 1.5
    FontColor #334155
    FontSize 11
    FontStyle bold
}

skinparam database {
    BackgroundColor #ECFDF5
    BorderColor #166534
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
    FontStyle bold
}

skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #334155
    FontColor #0F172A
    FontStyle bold
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.4

' =========================================================
' 1. HARDWARE LAYER
' =========================================================

package "1. Edge Hardware Layer" #EFF6FF {
    component "INMP441\nI2S Microphone" as Mic #DBEAFE
    component "Pushbuttons & LED\n(START: 27, STOP: 33, LED: 4)" as Controls #DBEAFE
    component "ESP32 Dev Module\nFirmware (16 kHz PCM)" as ESP #BFDBFE

    Mic --> ESP : I2S Audio (26, 25, 32)
    Controls --> ESP : GPIO Controls
}

' =========================================================
' 2. INGESTION LAYER
' =========================================================

package "2. Serial Ingestion Layer" #F5F3FF {
    component "Python Serial Bridge\n(tools/esp32_serial_bridge.py)" as Bridge #EDE9FE
}

' =========================================================
' 3. SESSION PROCESSING & AI ENGINE
' =========================================================

package "3. Backend & AI Inference Engine" #FAF5FF {
    component "Flask REST API\n(server.py)" as API #E0F2FE
    component "ContinuousSessionEngine\n(Audio Validation & 3s Slicing)" as Engine #DDD6FE
    component "HuBERT-D Inference Engine\n(Multi-Label Classifier)" as Model #C4B5FD
    component "Event Aggregator &\nSession Summary" as Aggregator #DDD6FE

    API --> Engine : Process session
    Engine --> Model : Sliding windows (3s/1s)
    Engine --> Aggregator : Multi-label probabilities
}

' =========================================================
' 4. STORAGE & VISUALIZATION
' =========================================================

package "4. Storage & Clinical Visualization" #F0FDF4 {
    database "SQLite Storage\n(voxflow.db)" as DB #ECFDF5
    component "Streamlit Dashboard\n(app/dashboard/dashboard_app.py)" as UI #DCFCE7

    actor "User / Clinician" as User #DBEAFE

    Engine --> DB : Persist windows & events
    API --> DB : Session lifecycle state
    DB --> UI : Stored session analytics
    UI --> User : Timelines, metrics & trends
}

' =========================================================
' CROSS-LAYER CONNECTIONS
' =========================================================

ESP --> Bridge : USB Serial (460800 baud)
Bridge --> API : HTTP REST API\n(POST /api/v1/session/*)

@enduml