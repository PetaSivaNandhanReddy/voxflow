@startuml
title <size:20><b>VoxFlow - Component Architecture Diagram</b></size>\n<size:12>Speech Fluency & Disfluency Session Analyzer</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
    FontStyle bold
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    BorderThickness 1.5
    FontColor #334155
    FontSize 11
    FontStyle bold
}

skinparam database {
    BackgroundColor #ECFDF5
    BorderColor #166534
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
    FontStyle bold
}

skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #334155
    FontColor #0F172A
    FontStyle bold
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.4

' =========================================================
' 1. HARDWARE LAYER
' =========================================================

package "1. Hardware Ingestion Layer" #EFF6FF {
    component "INMP441\nI2S Microphone" as Mic #DBEAFE
    component "Buttons & Status LED\n(START: 27, STOP: 33, LED: 4)" as Controls #DBEAFE
    component "ESP32 Dev Module\n(16 kHz Mono PCM Capture)" as ESP #BFDBFE

    Mic --> ESP : I2S Bus (SCK:26, WS:25, SD:32)
    Controls --> ESP : Hardware GPIO
}

' =========================================================
' 2. SERIAL INGESTION LAYER
' =========================================================

package "2. Serial Bridge Layer" #F5F3FF {
    component "Python Serial Bridge\n(tools/esp32_serial_bridge.py)" as Bridge #EDE9FE
}

' =========================================================
' 3. BACKEND & AI ENGINE
' =========================================================

package "3. Session Processing & AI Engine" #FAF5FF {
    component "Flask REST API\n(app/api/session_routes.py)" as API #E0F2FE
    component "Session Processing Engine\n(Audio Validation & 3s/1s Slicing)" as Engine #DDD6FE
    component "HuBERT-D Inference Engine\n(PyTorch Multi-Label Classifier)" as Model #C4B5FD
    component "Event Aggregation &\nSession Summary" as Summary #DDD6FE

    API --> Engine : Validate & slice audio (3s/1s)
    Engine --> Model : Window waveforms
    API --> Summary : Cluster events & calculate metrics
}

' =========================================================
' 4. STORAGE & DASHBOARD
' =========================================================

package "4. Storage & Session Dashboard" #F0FDF4 {
    database "SQLite Database\n(voxflow.db)" as DB #ECFDF5
    component "Streamlit Dashboard\n(app/dashboard/dashboard_app.py)" as UI #DCFCE7

    actor "User" as User #DBEAFE

    API --> DB : Persist session lifecycle & analysis results
    DB --> UI : Read stored session analytics
    UI --> User : Results, timelines & trends
}

' =========================================================
' CROSS-LAYER CONNECTIONS
' =========================================================

ESP --> Bridge : USB Serial / VXF1 framed PCM / 460800 baud
Bridge --> API : HTTP REST API (POST /api/v1/session/*)

@enduml