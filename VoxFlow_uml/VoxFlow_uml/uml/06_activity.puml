@startuml

title <size:20><b>VoxFlow - Activity Diagram</b></size>\n<size:12>End-to-End Speech Fluency Monitoring Workflow</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 160

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
    DiamondBackgroundColor #F5F3FF
    DiamondBorderColor #7C3AED
    DiamondFontColor #0F172A
    StartColor #86EFAC
    StopColor #FCA5A5
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3


start

#DBEAFE:Patient speaks;
#DBEAFE:INMP441 captures speech;
#DBEAFE:ESP8266 receives audio;
#DBEAFE:Send audio via Wi-Fi;

#E0F2FE:Receive audio chunk;
#DDD6FE:Buffer audio;

if (Audio window ready?) then (Yes)

    #DDD6FE:Check speech activity;

    if (Speech detected?) then (Yes)

        #EDE9FE:Extract audio features;
        #C4B5FD:Predict fluency / disfluency;
        #DCFCE7:Store prediction in SQLite;
        #DCFCE7:Update patient history and trends;
        #EDE9FE:Display latest result;
        #BBF7D0:Generate clinical report / export;
        #FEF3C7:Share report with speech therapist;

    else (No)

        #F8FAFC:Wait for next audio chunk;

    endif

else (No)

    #F8FAFC:Continue buffering;

endif

stop

@enduml