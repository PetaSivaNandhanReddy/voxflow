@startuml
title <size:20><b>VoxFlow - Use Case Diagram</b></size>\n<size:12>Speech Fluency & Disfluency Session Analyzer</size>

left to right direction

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam nodesep 28
skinparam ranksep 35

skinparam actorStyle awesome

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 2
    RoundCorner 15
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #475569
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 11
    FontStyle bold
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3

skinparam actor {
    FontColor #0F172A
    FontSize 12
    FontStyle bold
}

' =========================================================
' ACTORS
' =========================================================

actor "User / Speaker" as User #DBEAFE
actor "Speech Therapist\n(Optional Reviewer)" as Therapist #FEF3C7

' =========================================================
' SYSTEM BOUNDARY
' =========================================================

rectangle "VoxFlow Session Analysis System" {

    ' Audio Capture & Input
    usecase "Record Speech Session\n(ESP32 Hardware)" as UC_Record #DBEAFE
    usecase "Upload WAV Session\n(Direct Input)" as UC_Upload #DBEAFE

    ' Core AI Processing
    usecase "Analyze Speech Session" as UC_Analyze #EDE9FE
    usecase "Detect Disfluencies\n(Repetition, Prolongation, Block)" as UC_Detect #F5F3FF
    usecase "Aggregate Temporal Events" as UC_Aggregate #F5F3FF

    ' Results & Review
    usecase "View Session Result\n& Fluency Metrics" as UC_ViewResult #DCFCE7
    usecase "View Window-Level Predictions" as UC_ViewWindows #DCFCE7
    usecase "View Disfluency Timeline" as UC_ViewTimeline #DCFCE7
    usecase "View Session History" as UC_ViewHistory #DCFCE7
    usecase "View Fluency Trends" as UC_ViewTrends #DCFCE7
}

' =========================================================
' USER RELATIONSHIPS
' =========================================================

User --> UC_Record
User --> UC_Upload
User --> UC_Analyze
User --> UC_ViewResult
User --> UC_ViewWindows
User --> UC_ViewTimeline
User --> UC_ViewHistory
User --> UC_ViewTrends

' =========================================================
' INCLUSIONS
' =========================================================

UC_Analyze ..> UC_Detect : <<include>>
UC_Analyze ..> UC_Aggregate : <<include>>

' =========================================================
' THERAPIST RELATIONSHIPS
' =========================================================

Therapist --> UC_ViewResult
Therapist --> UC_ViewHistory
Therapist --> UC_ViewTrends

@enduml