@startuml
title <size:20><b>VoxFlow - ER Database Schema Diagram</b></size>\n<size:12>SQLite Relational Storage Architecture (voxflow.db)</size>

left to right direction

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam entity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.4

entity "users" as Users #DBEAFE {
    * id : TEXT <<PK>>
    --
    name : TEXT
    created_at : TIMESTAMP
}

entity "sessions" as Sessions #EDE9FE {
    * id : TEXT <<PK>>
    --
    user_id : TEXT <<FK>>
    started_at : TIMESTAMP
    ended_at : TIMESTAMP
    duration_sec : REAL
    audio_path : TEXT
    audio_filename : TEXT
    model_name : TEXT
    status : TEXT
    total_windows : INTEGER
    fluent_windows : INTEGER
    fluency_ratio : REAL
    repetition_count : INTEGER
    prolongation_count : INTEGER
    block_count : INTEGER
    created_at : TIMESTAMP
}

entity "session_windows" as Windows #DDD6FE {
    * id : INTEGER <<PK AUTOINCREMENT>>
    --
    session_id : TEXT <<FK>>
    window_index : INTEGER
    start_time : REAL
    end_time : REAL
    prob_repetition : REAL
    prob_prolongation : REAL
    prob_block : REAL
    is_fluent : INTEGER
    active_labels : TEXT
    confidence : REAL
}

entity "session_events" as Events #DCFCE7 {
    * id : INTEGER <<PK AUTOINCREMENT>>
    --
    session_id : TEXT <<FK>>
    event_type : TEXT
    start_time : REAL
    end_time : REAL
    confidence : REAL
    supporting_windows : INTEGER
}

Users ||--o{ Sessions : "records (1:N)"
Sessions ||--o{ Windows : "contains (1:N)"
Sessions ||--o{ Events : "aggregates (1:N)"

@enduml