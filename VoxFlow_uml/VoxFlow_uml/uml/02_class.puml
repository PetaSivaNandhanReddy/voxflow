@startuml
title <size:20><b>VoxFlow - Class & Architecture Structure Diagram</b></size>\n<size:12>Core Software Structure, Modules, and HuBERT-D Engine</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10
    AttributeFontSize 9
    MethodFontSize 9
    ArrowColor #64748B
}

skinparam ArrowThickness 1.4

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    BorderThickness 1.5
    FontColor #334155
    FontSize 11
    FontStyle bold
}

' =========================================================
' API & PRESENTATION LAYER
' =========================================================

package "API & Interface Layer" #EFF6FF {

    class "session_routes" as API <<controller>> #DBEAFE {
        + POST /api/v1/session/start
        + POST /api/v1/session/<id>/audio
        + POST /api/v1/session/<id>/stop
        + POST /api/v1/session/<id>/analyze
        + GET /api/v1/session/<id>
        + GET /api/v1/session/latest
    }

    class "dashboard_app" as UI <<presentation>> #DCFCE7 {
        Interactive Speech Fluency Dashboard
        (Streamlit Multi-Page Application)
    }
}

' =========================================================
' PROCESSING & INFERENCE ENGINE
' =========================================================

package "Session Processing & AI Engine" #F5F3FF {

    class "session_engine" as Engine <<module>> #EDE9FE {
        + validate_and_load_session_audio(audio_path_or_bytes, sample_rate=16000)
        + process_session_windows(session_id, audio, sr, duration_sec, engine=None)
        + process_continuous_session(audio_source, session_id=None, filename="session.wav", engine=None)
    }

    class "VoxFlowInferenceEngine" as InfEngine #C4B5FD {
        - model : HubertMultiLabelClassifier
        - device : torch.device
        - thresholds : dict
        + predict_window(waveform, sample_rate) : dict
        + get_model_info() : dict
    }

    class "HubertMultiLabelClassifier" as HubertModel #C4B5FD {
        - hubert : HubertModel
        - classifier : Sequential
        + forward(input_values, attention_mask) : Tensor
    }

    class "event_aggregator" as Aggregator <<module>> #DDD6FE {
        + aggregate_window_events(session_id, windows, min_support_windows=1, merge_gap_sec=1.5)
    }

    class "session_summary" as Summary <<module>> #DDD6FE {
        + calculate_session_summary(session_id, duration_sec, windows, events, model_name="VoxFlow")
    }
}

' =========================================================
' DATA PERSISTENCE LAYER
' =========================================================

package "Data Persistence Layer" #ECFDF5 {

    class "database" as DB <<module>> #DCFCE7 {
        - DB_PATH : Path
        + init_db(db_path=None)
        + save_session_record(...)
        + save_session_analysis(session_id, windows, events, summary, db_path=None)
        + save_session(session_data, windows, events, db_path=None)
        + get_session(session_id, db_path=None)
        + get_session_details(session_id, db_path=None)
        + get_latest_session(db_path=None)
        + get_all_sessions(user_id=None, limit=50, db_path=None)
    }
}

' =========================================================
' RELATIONSHIPS & DATA FLOW
' =========================================================

API --> Engine : invokes validation & window processing
Engine --> InfEngine : sliding-window inference (3.0s window, 1.0s hop)
InfEngine *-- HubertModel : PyTorch backbone & head
API --> Aggregator : clusters detected disfluent windows
API --> Summary : computes session-level fluency metrics
API --> DB : persists session metadata & analysis

UI --> DB : queries session results, history & trends
UI --> InfEngine : inspects model metadata & thresholds

@enduml