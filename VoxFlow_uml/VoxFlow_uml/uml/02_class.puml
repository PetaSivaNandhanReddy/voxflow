@startuml
title <size:20><b>VoxFlow - Class Diagram</b></size>\n<size:12>Core Software Architecture & Processing Pipeline</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 11
    AttributeFontSize 10
    MethodFontSize 10
    ArrowColor #64748B
}

skinparam ArrowThickness 1.4

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    BorderThickness 1.5
    FontColor #334155
    FontSize 12
    FontStyle bold
}

' =========================================================
' API & CONTROLLER LAYER
' =========================================================

package "API & Web Layer" #EFF6FF {

    class "FlaskSessionAPI" as API <<controller>> #DBEAFE {
        + start_session(user_id) : json
        + upload_audio(session_id, file) : json
        + stop_session(session_id) : json
        + analyze_session(session_id) : json
        + get_session(session_id) : json
        + get_latest_session() : json
    }

    class "DashboardApp" as UI <<presentation>> #DCFCE7 {
        + render_analyze_session()
        + render_current_session()
        + render_session_history()
        + render_fluency_trends()
        + render_model_info()
    }
}

' =========================================================
' PROCESSING & INFERENCE LAYER
' =========================================================

package "Session Processing & AI Engine" #F5F3FF {

    class "ContinuousSessionEngine" as Engine #EDE9FE {
        + process_continuous_session(audio_source, filename) : tuple
        + validate_and_load_session_audio(audio_source) : tuple
        + slice_and_predict_windows(audio, sr, engine) : list
    }

    class "HuBERTInferenceEngine" as Model #C4B5FD {
        - model : HuBERTMultiLabel
        - thresholds : dict
        - device : torch.device
        + predict_window(waveform, sample_rate) : dict
        + get_model_info() : dict
        - _apply_thresholds(probabilities) : tuple
    }

    class "EventAggregator" as Aggregator #DDD6FE {
        + aggregate_window_events(windows, thresholds) : list
        - _cluster_consecutive_active(windows, category) : list
    }

    class "SessionSummary" as Summary #DDD6FE {
        + calculate_session_summary(windows, events, duration) : dict
        + compute_fluency_ratio(total_windows, fluent_windows) : float
    }
}

' =========================================================
' DATA PERSISTENCE LAYER
' =========================================================

package "Data Persistence Layer" #ECFDF5 {

    class "DatabaseManager" as DB <<repository>> #DCFCE7 {
        - db_path : Path
        + init_db()
        + save_session_record(session_id, ...)
        + save_session_analysis(session_id, windows, events, summary)
        + save_session(summary, windows, events)
        + get_session_details(session_id) : dict
        + get_latest_session() : dict
        + get_all_sessions(limit) : list
    }
}

' =========================================================
' RELATIONSHIPS
' =========================================================

API --> Engine : triggers processing
Engine --> Model : sliding-window inference (3.0s/1.0s)
Engine --> Aggregator : clusters detected disfluencies
Engine --> Summary : calculates session metrics
Engine --> DB : persists session analysis

API --> DB : session lifecycle state

UI --> DB : queries sessions, windows, events
UI --> Model : fetches model info & thresholds

@enduml