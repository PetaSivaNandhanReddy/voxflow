@startuml
title <size:20><b>VoxFlow - Class & Architecture Structure Diagram</b></size>\n<size:12>Core Software Structure, Modules, and HuBERT-D Engine</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 11
    AttributeFontSize 10
    MethodFontSize 10
    ArrowColor #64748B
}

skinparam ArrowThickness 1.4

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    BorderThickness 1.5
    FontColor #334155
    FontSize 12
    FontStyle bold
}

' =========================================================
' API & PRESENTATION LAYER
' =========================================================

package "API & Interface Layer" #EFF6FF {

    class "session_routes" as API <<controller>> #DBEAFE {
        + POST /api/v1/session/start
        + POST /api/v1/session/<id>/audio
        + POST /api/v1/session/<id>/stop
        + POST /api/v1/session/<id>/analyze
        + GET /api/v1/session/<id>
        + GET /api/v1/session/latest
    }

    class "dashboard_app" as UI <<presentation>> #DCFCE7 {
        + render_analyze_session()
        + render_current_session()
        + render_session_history()
        + render_fluency_trends()
        + render_model_info()
    }
}

' =========================================================
' PROCESSING & INFERENCE ENGINE
' =========================================================

package "Session Processing & AI Engine" #F5F3FF {

    class "session_engine" as Engine <<module>> #EDE9FE {
        + validate_and_load_session_audio(audio_source)
        + process_session_windows(audio, sr, engine)
        + process_continuous_session(audio_source, filename)
    }

    class "VoxFlowInferenceEngine" as InfEngine #C4B5FD {
        - model : HubertMultiLabelClassifier
        - device : torch.device
        - thresholds : dict
        + predict_window(waveform, sample_rate) : dict
        + get_model_info() : dict
    }

    class "HubertMultiLabelClassifier" as HubertModel #C4B5FD {
        - hubert : HubertModel
        - classifier : Sequential
        + forward(input_values, attention_mask) : Tensor
    }

    class "event_aggregator" as Aggregator <<module>> #DDD6FE {
        + aggregate_window_events(windows, thresholds) : list
    }

    class "session_summary" as Summary <<module>> #DDD6FE {
        + calculate_session_summary(windows, events, duration) : dict
    }
}

' =========================================================
' DATA PERSISTENCE LAYER
' =========================================================

package "Data Persistence Layer" #ECFDF5 {

    class "database" as DB <<module>> #DCFCE7 {
        - DB_PATH : Path
        + init_db()
        + save_session_record(session_id, ...)
        + save_session_analysis(session_id, windows, events, summary)
        + save_session(summary, windows, events)
        + get_session_details(session_id) : dict
        + get_latest_session() : dict
        + get_all_sessions(limit) : list
    }
}

' =========================================================
' RELATIONSHIPS & DATA FLOW
' =========================================================

API --> Engine : triggers session processing
Engine --> InfEngine : invokes sliding-window inference (3s window, 1s hop)
InfEngine *-- HubertModel : contains PyTorch neural network
Engine --> Aggregator : clusters contiguous disfluent windows
Engine --> Summary : computes session-level fluency metrics
Engine --> DB : persists session analysis

API --> DB : tracks session lifecycle

UI --> DB : reads session results, history & trends
UI --> InfEngine : reads model parameters & thresholds

@enduml