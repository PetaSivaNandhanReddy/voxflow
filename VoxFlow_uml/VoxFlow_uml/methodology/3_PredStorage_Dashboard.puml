@startuml
title <size:20><b>VoxFlow - Event Aggregation & Session Analytics Flow</b></size>\n<size:12>Temporal Clustering, Metric Calculation & Dashboard Visualization</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10

    DiamondBackgroundColor #F5F3FF
    DiamondBorderColor #7C3AED
    DiamondFontColor #0F172A

    StartColor #86EFAC
    StopColor #FCA5A5
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3

start

#E0F2FE:Receive window-level prediction array\nfrom Session Processing Engine;

#EDE9FE:Execute Temporal Event Aggregation:\n- Iterate across active window categories\n- Group consecutive overlapping disfluent windows\n- Calculate event start time, end time & duration\n- Compute average detection confidence;

#DDD6FE:Calculate Session Fluency Metrics:\n- Count Total Windows & Fluent Windows\n- Compute Session Fluency Ratio = (Fluent / Total)\n- Count Repetition, Prolongation & Block events;

#ECFDF5:Persist atomic session record in SQLite (voxflow.db):\n- UPDATE sessions (duration, status="ANALYZED", metrics)\n- INSERT INTO session_windows (probabilities, labels, confidence)\n- INSERT INTO session_events (type, start, end, confidence);

#DCFCE7:Streamlit Dashboard queries latest / selected session;

#DCFCE7:Render Interactive Session Visualizations:\n- Key Summary Cards (Duration, Fluency %, Counts)\n- Multi-Label Probability Timeline (Rep, Pro, Blk curves)\n- Window-Level Model Output Audit Table\n- Aggregated Disfluency Event Visualizer\n- Longitudinal Speech Fluency Trends;

stop

@enduml