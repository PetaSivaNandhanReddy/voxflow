@startuml
title <size:20><b>VoxFlow - Hardware Capture & Transmission Flow</b></size>\n<size:12>ESP32 Firmware & USB Serial Protocol Execution</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10

    DiamondBackgroundColor #F5F3FF
    DiamondBorderColor #7C3AED
    DiamondFontColor #0F172A

    StartColor #86EFAC
    StopColor #FCA5A5
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3

start

#DBEAFE:Initialize ESP32 Dev Module;\nConfigure I2S peripheral (SCK: 26, WS: 25, SD: 32);
#DBEAFE:Set START (GPIO27) & STOP (GPIO33) to INPUT_PULLUP;\nSet Status LED (GPIO4) to OUTPUT (LOW);
#DBEAFE:Initialize 16-slot Ring Buffer Queue (32 KB);\nEmit "READY" & synchronize via PING / PONG;

if (START Trigger Received?) then (Physical Button or Serial START)

    #BFDBFE:Turn Status LED ON (GPIO4 HIGH);\nSend Protocol Header (STREAM=VXF1, DATA_START);

    repeat
        #BFDBFE:Capture 1024 samples via INMP441 I2S DMA;\nConvert 24-bit to 16-bit PCM (clamped [-32768, 32767]);
        #BFDBFE:Enqueue audio frame into FreeRTOS ring buffer;\n(Check for buffer overrun / I2S stall);
        #EDE9FE:Consumer pops frame & computes CRC32;\nTransmit VXF1 frame (Magic, Seq, Length, CRC32, Payload);
        #EDE9FE:Python Bridge validates sequence & CRC32;\nAppends verified PCM payload to session stream;

        if (STOP Requested or 60s hard limit reached?) then (Yes)
            #DDD6FE:Flush remaining buffered frames in queue;\nTerminate producer capture task;
            break
        endif

    repeat while (Continuous Speech Streaming Active) is (Yes)

    #EDE9FE:Transmit zero-length terminal frame\n(Magic: VXF1, Seq: N, Length: 0, CRC32: 0);

    #EDE9FE:Transmit "DONE" text marker;

    #EDE9FE:Python Bridge reconstructs ONE continuous WAV\n(16 kHz, 16-bit Mono PCM, 3.0s - 60.0s);

    #DCFCE7:Turn Status LED OFF (GPIO4 LOW);\nReturn to idle listening state;

else (No)

    #F8FAFC:Remain in idle standby;

endif

stop

@enduml