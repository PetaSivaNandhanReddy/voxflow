@startuml
title <size:20><b>VoxFlow - Hardware Capture & Transmission Flow</b></size>\n<size:12>ESP32 Firmware & USB Serial Protocol Execution</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10

    DiamondBackgroundColor #F5F3FF
    DiamondBorderColor #7C3AED
    DiamondFontColor #0F172A

    StartColor #86EFAC
    StopColor #FCA5A5
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3

start

#DBEAFE:Initialize ESP32 Dev Module;\nConfigure I2S peripheral (SCK: 26, WS: 25, SD: 32);
#DBEAFE:Set START (GPIO27) & STOP (GPIO33) to INPUT_PULLUP;\nSet Status LED (GPIO4) to OUTPUT (LOW);
#DBEAFE:Allocate audio buffer (PSRAM / Internal SRAM);\nEmit "READY" & synchronize via PING / PONG;

if (START Trigger Received?) then (Physical Button or Serial START)

    #BFDBFE:Turn Status LED ON (GPIO4 HIGH);\nClear I2S DMA buffer;

    repeat
        #BFDBFE:Sample 16 kHz audio via INMP441 I2S;\nConvert to 16-bit PCM with clamping;
        #BFDBFE:Store PCM samples in buffer;

        if (STOP Requested?) then (Yes)
            #DDD6FE:Terminate capture loop early;
            break
        endif

    repeat while (60-second maximum reached?) is (No)

    #DDD6FE:Calculate exact dynamic AUDIO_BYTES;

    #EDE9FE:Emit Protocol Header:\nRECORDING\nAUDIO_BYTES=<exact_bytes>\nSAMPLE_RATE=16000\nFORMAT=PCM_S16LE_MONO;

    #EDE9FE:Transmit exact binary PCM payload\nover USB Serial (460800 baud);

    #EDE9FE:Flush UART & transmit "DONE" marker;

    #DCFCE7:Turn Status LED OFF (GPIO4 LOW);\nReturn to idle listening state;

else (No)

    #F8FAFC:Remain in idle standby;

endif

stop

@enduml