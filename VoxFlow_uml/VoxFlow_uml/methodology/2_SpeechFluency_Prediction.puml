@startuml
title <size:20><b>VoxFlow - HuBERT-D Session Analysis Flow</b></size>\n<size:12>Continuous Audio Validation & Sliding-Window Inference</size>

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam dpi 170

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 10

    DiamondBackgroundColor #F5F3FF
    DiamondBorderColor #7C3AED
    DiamondFontColor #0F172A

    StartColor #86EFAC
    StopColor #FCA5A5
}

skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3

start

#E0F2FE:Receive session audio\n(WAV container / 16 kHz mono);

#E0F2FE:Validate audio signal:\n- Minimum duration >= 3.0 seconds\n- RMS speech energy check\n- Float32 normalization in [-1.0, 1.0];

#EDE9FE:Initialize sliding-window parameters:\n- Window Duration = 3.0s (48,000 samples)\n- Window Step Hop = 1.0s (16,000 samples);

while (Window slice available?) is (Yes)

    #EDE9FE:Extract 3.0-second waveform segment;

    #C4B5FD:Pass waveform to HuBERT-D\n(facebook/hubert-base-ls960 backbone);

    #C4B5FD:Compute 3 independent multi-label\nsigmoid posterior probabilities;

    #DDD6FE:Evaluate against locked decision thresholds:\n- Repetition: Prob >= 0.77\n- Prolongation: Prob >= 0.79\n- Block: Prob >= 0.57;

    if (Any threshold exceeded?) then (Yes)
        #FCA5A5:Classify window as DISFLUENT;\nAssign active label(s) & confidence;
    else (No)
        #86EFAC:Classify window as FLUENT;\nAssign confidence = 0.99;
    endif

    #DCFCE7:Append window record:\n{start_time, end_time, probabilities, active_labels};

endwhile (No)

#DCFCE7:Pass complete window prediction list\nto Temporal Event Aggregator;

stop

@enduml